          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "receipts",
            "{{purchase_id}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "[\"pm.test('status 200', () => pm.response.to.have.status(200));\", \"pm.test('receipt hash present', () => pm.expect(JSON.stringify(pm.response.json())).to.match(/[0-9a-f]{64}/));\"]"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": []
          }
        }
      ]
    },
