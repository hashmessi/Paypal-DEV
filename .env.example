# PromiseLoop Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ==============================================================================
# 1. PayPal REST API Credentials (Sandbox)
# Required for live PayPal sandbox authorization and capture.
# If omitted or left as "test", the app operates with an in-memory FakeGateway.
# ==============================================================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ==============================================================================
# 2. Database
# SQLite is used locally. PostgreSQL is used when deployed on Render.
# ==============================================================================
DATABASE_URL=sqlite:///./promiseloop.db

# ==============================================================================
# 3. LLM API Providers (Optional)
# The intent extractor uses Gemini as primary, OpenRouter free as secondary,
# and deterministic regex parser as fallback.
# If these keys are empty, PromiseLoop operates 100% offline using the fallback parser.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=
CHANNEL3_API_KEY=

# ==============================================================================
# 4. Security & Demo Environment
# ==============================================================================
ADMIN_TOKEN=your_admin_secret_token_here
DEMO_MODE=true
ENVIRONMENT=development
LLM_RATE_LIMIT_PER_MIN=10
SECRET_KEY=promiseloop-dev-secret-key-change-in-prod
