{
  "info": {
    "name": "PromiseLoop - promise-gated settlement",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runs the full golden path: authorize, drift blocks capture, injection ignored, corrected fulfillment allows capture, repeat capture is idempotent, replay + ledger verified."
  },
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create approved receipt + PayPal authorization (fresh each run)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/demo/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "demo",
            "run"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('purchase_id', pm.response.json().purchase_id);",
              "pm.test('purchase_id returned', () => pm.expect(pm.collectionVariables.get('purchase_id')).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
