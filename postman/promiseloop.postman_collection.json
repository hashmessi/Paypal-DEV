      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409', () => pm.response.to.have.status(409));",
              "pm.test('blocked by gate', () => pm.expect(JSON.stringify(pm.response.json())).to.include('CAPTURE_BLOCKED_BY_GATE'));"
            ]
